# Default: normalize to LF in repo, checkout as-is
* text=auto

# Shell scripts must have LF (executed on Linux)
*.sh text eol=lf

# Windows scripts can use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Source and config files: normalize to LF
*.c   text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.md   text eol=lf

# Binaries: do not touch
*.exe binary
*.dll binary
*.so  binary
*.a   binary
