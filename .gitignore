# ============================================================
# Build outputs
# ============================================================
build/
dist/

# ============================================================
# CMake internal files
# ============================================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
*.ninja
.ninja_deps
.ninja_log
compile_commands.json

# ============================================================
# Generated source files (regenerated by tools/generate_*.py)
# Do NOT edit these manually.
# Regenerate: python tools/generate_registry_from_manifest.py
# ============================================================
src/dfbench_runtime_win_core.c
src/dfbench_runtime_posix.c
src/dfbench_runtime_cpp.c
src/dfbench_runtime_cpp_exceptions.c

# ============================================================
# Compiled binaries and libraries
# (outside build/ — e.g. if built in-source accidentally)
# ============================================================
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.lib
*.pdb
*.ilk
*.exp

# Except importlib headers (these are source, not output)
!importlib/*.h
!importlib/*.c

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
.eggs/

# ============================================================
# IDE / Editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.vs/
*.vcxproj.user

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Misc
# ============================================================
*.orig
*.bak
*.tmp
*.log
